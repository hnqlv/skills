#!/usr/bin/env python3
"""Show a drawing in a Herdr pane beside the calling agent.

  draw file.svg    show the SVG, rendered to fit the canvas pane
  draw file.png    show the PNG
  draw --close     close the canvas pane
"""
import base64
import fcntl
import json
import math
import os
import re
import select
import shutil
import struct
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
ROOT = Path.home() / ".cache" / "herdr-draw"
CELL_UNITS = 8  # SVG units per terminal column at full size; 14-unit text then matches terminal text
HERDR_SETTINGS = Path.home() / ".config" / "herdr-app" / "settings.json"
HUES = ("red", "green", "yellow", "blue", "magenta", "cyan")  # ANSI colors 1 to 6
FALLBACK_THEME = {"fg": "#d7dae0", "bg": "#17191d", "red": "#f07f7f", "green": "#7fd49e", "yellow": "#e0a458",
                  "blue": "#7ab0f5", "magenta": "#b59cf0", "cyan": "#7fd0d4"}  # fmt: skip


def fail(message):
    sys.exit(f"draw: {message}")


def app(*args):
    done = subprocess.run(["herdr-app", *args], capture_output=True, text=True)
    if done.returncode:
        fail(f"herdr-app {args[0]} failed: {(done.stderr or done.stdout).strip()}")
    return json.loads(done.stdout) if done.stdout.strip() else {}


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def stamp(path):
    try:
        return path.stat().st_mtime_ns
    except OSError:
        return 0


def panes():
    """Map each terminal shown in the window to its pane."""
    return {
        terminal["terminal"]: terminal["pane"]
        for space in app("ls")["spaces"]
        for tab in space["tabs"]
        for terminal in tab["terminals"]
    }


def svg_size(svg):
    tag = re.search(r"<svg\b[^>]*>", svg.read_text(), re.S)
    if not tag:
        raise ValueError(f"{svg.name} has no <svg> element")
    size = [re.search(rf'\b{name}="([\d.]+)(?:px)?"', tag.group(0)) for name in ("width", "height")]
    if all(size):
        return [float(match.group(1)) for match in size]
    box = re.search(r'\bviewBox="([^"]+)"', tag.group(0))
    if not box:
        raise ValueError(f"{svg.name} needs a viewBox, or a width and height")
    return [float(number) for number in box.group(1).replace(",", " ").split()][2:]


# --- the agent's side ---------------------------------------------------


def open_canvas(state):
    """Split a pane for the viewer unless one is live."""
    shown = panes()
    canvas = read_json(state / "canvas.json")
    pane_open = canvas.get("pane") in shown.values()
    if pane_open and alive(read_json(state / "viewer.json").get("pid")):
        return
    if pane_open:
        app("do", "pane.close", json.dumps({"pane": canvas["pane"]}))

    me = shown.get(state.name)
    if not me:
        fail(f"terminal {state.name} has no pane in the Herdr window")
    state.mkdir(parents=True, exist_ok=True)
    (state / "viewer.json").unlink(missing_ok=True)
    focus = app("status").get("focused_pane")
    viewer = [os.path.realpath(__file__), "--view", str(state)]
    canvas = app("do", "pane.split", json.dumps({"direction": "right", "pane": me, "argv": viewer}))
    (state / "canvas.json").write_text(json.dumps(canvas))
    if focus and app("status").get("focused_pane") != focus:
        app("do", "pane.focus", json.dumps({"pane": focus}))


def draw(state, source):
    kind = source.suffix.lower()
    if kind not in (".svg", ".png"):
        fail("give an .svg or .png file")
    if not source.is_file():
        fail(f"{source} does not exist")
    if kind == ".svg":
        if not os.path.exists(CHROME):
            fail(f"SVG rendering needs Google Chrome at {CHROME}")
        try:
            svg_size(source)
        except ValueError as error:
            fail(error)

    open_canvas(state)
    staged, current = state / f"staged{kind}", state / f"current{kind}"
    shutil.copyfile(source, staged)
    os.replace(staged, current)
    if kind == ".png":
        (state / "current.svg").unlink(missing_ok=True)

    # The viewer renders and paints; wait for it, so the preview is ready to read.
    for _ in range(200):
        viewer = read_json(state / "viewer.json")
        if viewer.get("shown") == stamp(current):
            break
        time.sleep(0.1)
    else:
        fail("the canvas pane did not show the drawing")
    if viewer.get("error"):
        fail(viewer["error"])
    print(f"shown: {source}\npreview: {state / 'shown.png'}")


def close(state):
    canvas = read_json(state / "canvas.json")
    if canvas.get("pane") in panes().values():
        app("do", "pane.close", json.dumps({"pane": canvas["pane"]}))
    shutil.rmtree(state, ignore_errors=True)


# --- the viewer, which runs in the canvas pane ---------------------------


def ask(query, answer):
    """Send a query to the terminal and return the match in its reply, if any."""
    sys.stdout.write(query)
    sys.stdout.flush()
    reply = b""
    while select.select([0], [], [], 0.5)[0]:
        reply += os.read(0, 64)
        match = re.search(answer, reply)
        if match:
            return match


def pixel_size(cols, rows):
    """The tty does not report its size in pixels, so ask the terminal."""
    match = ask("\x1b[14t", rb"\x1b\[4;(\d+);(\d+)t")
    if match:
        return int(match.group(2)), int(match.group(1))
    return cols * 8, rows * 17  # no answer; assume a common cell


def theme():
    """Ask the terminal for its text color, pane color, and ANSI colors."""
    names = {"10": "fg", "11": "bg", **{f"4;{index + 1}": hue for index, hue in enumerate(HUES)}}
    sys.stdout.write("".join(f"\x1b]{code};?\x1b\\" for code in names))
    sys.stdout.flush()
    reply = b""
    while reply.count(b"rgb:") < len(names) and select.select([0], [], [], 0.5)[0]:
        reply += os.read(0, 4096)
    colors = dict(FALLBACK_THEME)
    for code, *rgb in re.findall(rb"\x1b\]([\d;]+);rgb:(\w+)/(\w+)/(\w+)", reply):
        colors[names[code.decode()]] = "#" + "".join(part[:2].decode() for part in rgb)
    return colors


def themed(svg, colors):
    """Give the SVG the terminal's font and colors as CSS variables, and a hatch pattern."""
    font = read_json(HERDR_SETTINGS).get("font") or "JetBrains Mono"
    variables = [f"--{name}: {color};" for name, color in colors.items()]
    variables += [f"--{hue}-row: color-mix(in srgb, var(--{hue}) 35%, var(--bg));" for hue in HUES]
    style = f"""<style>
      svg {{
        {" ".join(variables)}
        --muted: color-mix(in srgb, var(--fg) 55%, var(--bg));
        --row: color-mix(in srgb, var(--fg) 9%, var(--bg));
        font-family: "{font}", "Geist Mono", ui-monospace, Menlo, monospace;
        font-size: 16px;
        fill: var(--fg);
      }}
    </style>
    <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="8" height="8" style="fill: color-mix(in srgb, var(--fg) 3%, var(--bg))"/>
      <rect width="2" height="8" style="fill: color-mix(in srgb, var(--fg) 10%, var(--bg))"/>
    </pattern>"""
    return re.sub(r"(<svg\b[^>]*>)", lambda tag: tag.group(1) + style, svg.read_text(), count=1, flags=re.S)


def render(svg, png, cols, width, height):
    """Render the SVG in the terminal's theme, as large as fits, up to full size. Return an error or None."""
    try:
        svg_width, svg_height = svg_size(svg)
        colors = theme()
        styled = png.with_name("themed.svg")
        styled.write_text(themed(svg, colors))
    except (OSError, ValueError) as error:
        return str(error)
    scale = min(width / svg_width, height / svg_height, width / cols / CELL_UNITS)
    staged = png.with_name("rendered.png")
    staged.unlink(missing_ok=True)
    try:
        subprocess.run(
            [
                CHROME,
                "--headless",
                f"--screenshot={staged}",
                f"--window-size={math.ceil(svg_width)},{math.ceil(svg_height)}",
                f"--force-device-scale-factor={scale:.4f}",
                f"--default-background-color={colors['bg'][1:]}ff",
                "--hide-scrollbars",
                f"--user-data-dir={ROOT / 'chrome'}",
                styled.as_uri(),
            ],
            capture_output=True,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return f"Chrome failed: {error}"
    if not staged.exists():
        return "Chrome did not render the SVG"
    os.replace(staged, png)


def paint(png, error, cols, rows, width, height):
    out = ["\x1b_Ga=d,d=A\x1b\\\x1b[2J\x1b[H"]
    if error or not png.exists():
        out.append(f"draw: {error or 'no drawing yet'}")
    else:
        data = png.read_bytes()
        image_width, image_height = struct.unpack(">II", data[16:24])
        cell_width, cell_height = width / cols, height / rows
        scale = min(1, width / image_width, height / image_height)
        used_cols = min(cols, math.ceil(image_width * scale / cell_width))
        keys = "a=T,f=100,q=2,C=1"
        if scale < 1:  # a full-size image stays unscaled, so it stays sharp
            keys += f",c={used_cols},r={min(rows, math.ceil(image_height * scale / cell_height))}"
        payload = base64.standard_b64encode(data).decode()
        chunks = [payload[start : start + 4096] for start in range(0, len(payload), 4096)]
        for index, chunk in enumerate(chunks):
            more = int(index < len(chunks) - 1)
            out.append(f"\x1b_G{keys + ',' if index == 0 else ''}m={more};{chunk}\x1b\\")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def view(state):
    """Render and paint when the drawing or the pane size changes. Press q to quit."""
    svg, png, shown = state / "current.svg", state / "current.png", state / "shown.png"
    saved = termios.tcgetattr(0)
    tty.setcbreak(0)
    sys.stdout.write("\x1b[?25l")
    grid = last = None
    try:
        while True:
            rows, cols = struct.unpack("HHHH", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))[:2]
            if (cols, rows) != grid:
                grid = (cols, rows)
                width, height = pixel_size(cols, rows)
            source = svg if svg.exists() else png
            now = (grid, source, stamp(source))
            if now != last:
                last = now
                error = None
                if source == svg:
                    error = render(svg, shown, cols, width, height)
                elif now[2]:
                    shutil.copyfile(png, shown)
                paint(shown, error, cols, rows, width, height)
                report = {"pid": os.getpid(), "shown": now[2], "error": error}
                (state / "viewer.json").write_text(json.dumps(report))
            if select.select([0], [], [], 0.25)[0] and b"q" in os.read(0, 64):
                break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, saved)
        sys.stdout.write("\x1b[?25h")


def main():
    args = sys.argv[1:]
    if args[:1] == ["--view"] and len(args) == 2:
        return view(Path(args[1]))
    if len(args) != 1 or args[0] in ("-h", "--help"):
        return print(__doc__.strip())
    terminal = os.environ.get("HC_TERMINAL_ID")
    if not terminal:
        fail("not in a Herdr terminal (HC_TERMINAL_ID is not set)")
    state = ROOT / terminal
    if args == ["--close"]:
        return close(state)
    draw(state, Path(args[0]))


if __name__ == "__main__":
    main()
